{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ludi",
  "main": "apps/worker/index.ts",
  "account_id": "203bf3287fc4eb1260ec344a3e0f5071",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "ludi.allencreativetechnologies.uk", "custom_domain": true }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/ws", "/api/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "LudiRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LudiRoom"] }],
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
